---
import Base from '../layouts/Base.astro';
import ClassAtlas from '../components/ClassAtlas.astro';
---
<Base title="Fixed-cell chromosome atlas">
  <section class="research-head">
    <div class="shell page-head">
      <p class="eyebrow">Fixed cells · G-banding & FISH</p>
      <h1>The chromosome atlas</h1>
      <p class="lead">Choose a class to see it in G-banding and FISH. Drag the divider to compare the reference and the prediction in each field.</p>
    </div>
  </section>
  <ClassAtlas />
</Base>
