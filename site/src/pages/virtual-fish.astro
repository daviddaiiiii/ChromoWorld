---
import Base from '../layouts/Base.astro';
import ClassAtlas from '../components/ClassAtlas.astro';
---
<Base title="Fixed-cell chromosome atlas">
  <section class="research-head">
    <div class="shell page-head">
      <p class="eyebrow">Fixed cells · G-banding & FISH</p>
      <h1>Explore chromosome identity.</h1>
      <p class="lead">Browse all 24 chromosome classes and drag to compare annotations with ChromoPix predictions in the same field.</p>
    </div>
  </section>
  <ClassAtlas />
</Base>
