---
import Base from '../layouts/Base.astro';
import StateMap from '../components/StateMap.astro';
const classes = [...Array.from({length:22},(_,i)=>String(i+1)), 'X', 'Y'];
---
<Base title="Identity across states">
  <section class="shell page-head">
    <p class="eyebrow">Chromosome morphology</p>
    <h1>Identity across states</h1>
    <p class="lead">Where does the same chromosome class sit in G-banding, FISH and live cells? Compare its center against the full distribution of shapes in each state.</p>
  </section>
  <section class="shell" id="shape-view" aria-label="Cross-state UMAP explorer">
    <div class="controls map-controls">
      <label for="shape-chr">Chromosome class</label>
      <select class="control" id="shape-chr"><option value="">All classes</option>{classes.map(c=><option value={c}>{'Chr'+c}</option>)}</select>
      <label class="center-toggle"><input type="checkbox" id="centroid-toggle" checked /> Show centroids</label>
    </div>
    <div class="state-triptych">
      <StateMap map="banding" title="G-banding" description="Fixed cells · banded chromosomes" />
      <StateMap map="fish" title="FISH" description="Fixed cells · probe-labeled preparations" />
      <StateMap map="live" title="Live" description="Dividing cells · ChromoID assignments" />
    </div>
    <p class="map-readout" id="shape-note" aria-live="polite">Select a class or click a centroid to locate it in all three states.</p>
    <p class="scientific-note">Each cloud shows chromosome instances. The line joins class centers in the paper’s chromosome order. Each state has its own UMAP axes. The fixed-cell maps include annotations and predictions (Fig. 4). Live colors show inferred identities (Fig. 5E).</p>
    <details class="other-spaces">
      <summary>Explore the joint fixed-cell embedding and other live-cell representations</summary>
      <div class="controls map-controls"><label for="live-mode">Live representation</label>
        <select class="control" id="live-mode">
          <option value="naive">Direct projection</option><option value="geometry">3D morphology</option><option value="lifted">Lifted projection</option>
        </select>
      </div>
      <div class="state-triptych alternate-maps">
        <StateMap map="joint" title="G-banding + FISH" description="Joint fixed-cell UMAP" />
        <StateMap map="naive" title="Projected morphology" description="Live-cell DNA projection" />
        <div hidden data-alternate="geometry"><StateMap map="geometry" title="3D morphology" description="Measured live-cell descriptors" /></div>
        <div hidden data-alternate="lifted"><StateMap map="lifted" title="Lifted projection" description="Live-cell projection after lifting" /></div>
      </div>
    </details>
  </section>
</Base>
<script>
  const root=document.querySelector<HTMLElement>('#shape-view')!;
  const picker=root.querySelector<HTMLSelectElement>('#shape-chr')!;
  const toggle=root.querySelector<HTMLInputElement>('#centroid-toggle')!;
  const note=root.querySelector<HTMLElement>('#shape-note')!;
  const figures=[...root.querySelectorAll<HTMLElement>('[data-map]')];
  function update(){
    const id=picker.value;
    root.classList.toggle('cloud-only',!toggle.checked);
    for (const chart of figures) {
      chart.classList.toggle('has-selection',Boolean(id)&&toggle.checked);
      const markers=[...chart.querySelectorAll<SVGGElement>('.map-marker')];
      const chosen=chart.querySelector<SVGGElement>('.chosen-marker')!;
      const match=markers.find(m=>m.dataset.class===id);
      for(const marker of markers) marker.classList.toggle('selected',marker===match);
      chosen.setAttribute('visibility',match?'visible':'hidden');
      if(match){
        const dot=match.querySelector('.center-dot')!;
        chosen.setAttribute('transform',`translate(${dot.getAttribute('cx')} ${dot.getAttribute('cy')})`);
        chosen.querySelector('text')!.textContent='Chr'+id;
      }
    }
    note.textContent = !toggle.checked ? 'Showing the full UMAP distributions.' : id ?
      'Chr'+id+' is highlighted in G-banding, FISH and live cells.' : 'Select a class or click a centroid to locate it in all three states.';
  }
  function choose(id:string){
    picker.value=id; if(id) toggle.checked=true;
    const url=new URL(location.href);
    if(id) url.searchParams.set('chr',id);else url.searchParams.delete('chr');
    history.replaceState(null,'',url);
    update();
  }
  const initial=new URL(location.href).searchParams.get('chr');
  if(initial && [...picker.options].some(option=>option.value===initial)) picker.value=initial;
  picker.addEventListener('change',()=>choose(picker.value));
  toggle.addEventListener('change',update);
  root.addEventListener('click',e=>{
    const marker=(e.target as Element).closest<SVGGElement>('.map-marker');
    if(marker?.dataset.class) choose(marker.dataset.class);
  });
  const liveMode=root.querySelector<HTMLSelectElement>('#live-mode')!;
  liveMode.addEventListener('change',()=>{
    root.querySelector<HTMLElement>('[data-map="naive"]')!.hidden=liveMode.value!=='naive';
    for(const el of root.querySelectorAll<HTMLElement>('[data-alternate]')) el.hidden=el.dataset.alternate!==liveMode.value;
  });
  update();
</script>
<style is:global>
  #shape-view{padding-bottom:54px}
  .map-controls{margin:0 0 16px;align-items:center}
  .center-toggle{display:flex;align-items:center;gap:7px;margin-left:auto;cursor:pointer}
  .center-toggle input{accent-color:var(--accent)}
  .state-triptych{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2px;border-radius:12px;overflow:hidden;background:#303036}
  .state-map{margin:0;background:black;color:white;min-width:0}
  .state-map figcaption{padding:18px 20px 0}
  .state-map h3{font-size:1.18rem;margin:0 0 4px;color:#f4f4f8}
  .state-map figcaption p{margin:0;font-size:.87rem;color:#bfbfc8}
  .state-map svg{display:block;width:100%}
  .map-axes{fill:none;stroke:#54545f}.axis-label{fill:#bebec9;font-size:12px}
  .state-cloud{opacity:.56}.cloud-only .state-cloud{opacity:1}
  .center-path{fill:none;stroke:#e3e1ec;stroke-width:1.4;stroke-linejoin:round}
  .map-marker{cursor:pointer}.center-dot{stroke:#f3f2f5;stroke-width:.8}
  .map-marker:hover .center-dot{stroke-width:2}
  .chosen-label{fill:white;stroke:#080808;stroke-width:3px;paint-order:stroke;font-weight:650;font-size:14px}
  .has-selection .map-marker:not(.selected){opacity:.36}.has-selection .center-path{opacity:.52}
  .cloud-only .state-centers{display:none}
  .map-readout{margin:12px 0 5px;font-weight:600}
  .other-spaces{margin-top:32px;border-top:1px solid var(--line)}
  .other-spaces summary{cursor:pointer;padding:14px 0;font-weight:650}
  .alternate-maps{grid-template-columns:repeat(2,minmax(0,1fr));max-width:880px}
  @media(max-width:680px){
    .state-triptych,.alternate-maps{grid-template-columns:1fr}
    .state-map{width:100%}.state-map svg{max-height:350px}
    .center-toggle{margin-left:0}
  }
</style>
