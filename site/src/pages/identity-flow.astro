---
import Base from '../layouts/Base.astro';
import StateMap from '../components/StateMap.astro';
const classes = [...Array.from({length:22},(_,i)=>String(i+1)), 'X', 'Y'];
---
<Base title="Identity across states">
  <section class="shell page-head">
    <p class="eyebrow">Chromosome morphology</p>
    <h1>Identity across states</h1>
    <p class="lead">Follow a chromosome class from G-banding and FISH to dividing cells.</p>
  </section>
  <section class="shell" id="shape-view" aria-label="Cross-state UMAP explorer">
    <div class="controls map-controls">
      <label for="shape-chr">Chromosome class</label>
      <select class="control" id="shape-chr"><option value="">All classes</option>{classes.map(c=><option value={c}>{'Chr'+c}</option>)}</select>
      <label class="center-toggle"><input type="checkbox" id="centroid-toggle" checked /> Show centroids</label>
    </div>
    <div class="state-triptych">
      <StateMap map="banding" title="G-banding" description="Fixed cells · banded chromosomes" />
      <StateMap map="fish" title="FISH" description="Fixed cells · probe-labeled preparations" />
      <StateMap id="chromophy" map="live" title="Live cells · ChromoPhy" description="Fig. 5E · ChromoID assignments in 3D" />
    </div>
    <p class="scientific-note">Chr1 is on the left and ChrY on the right. The FISH map is flipped vertically. Lines connect the class centers in the order used in the paper.</p>
    <StateMap id="aligned" map="overlay" title="Three states, aligned" description="G-banding, FISH and live cells share a reference defined by all 24 chromosome classes." />
    <p class="scientific-note">Each state contributes equally to the mean position of each class. The fit rotates and translates each map toward those shared centers, preserving distances within each map.</p>
    <p class="map-readout" id="shape-note" aria-live="polite">Select a chromosome class to highlight its center in every view.</p>
  </section>
</Base>
<script>
  const root=document.querySelector<HTMLElement>('#shape-view')!;
  const picker=root.querySelector<HTMLSelectElement>('#shape-chr')!;
  const toggle=root.querySelector<HTMLInputElement>('#centroid-toggle')!;
  const note=root.querySelector<HTMLElement>('#shape-note')!;
  function update(){
    const chr=picker.value;
    root.classList.toggle('cloud-only',!toggle.checked);
    root.classList.toggle('has-selection',Boolean(chr));
    for(const marker of root.querySelectorAll<SVGGElement>('.map-marker')){
      marker.classList.toggle('selected',marker.dataset.class===chr);
    }
    note.textContent = !toggle.checked ? 'Showing the full UMAP distributions.' : chr ?
      'Chr'+chr+' is highlighted in every visible state.' : 'Select a chromosome class to highlight its center in every view.';
  }
  function choose(chr:string){
    picker.value=chr;
    if(chr) toggle.checked=true;
    const url=new URL(location.href);
    if(chr) url.searchParams.set('chr',chr); else url.searchParams.delete('chr');
    history.replaceState(null,'',url);
    update();
  }
  const initial=new URL(location.href).searchParams.get('chr');
  if(initial && [...picker.options].some(option=>option.value===initial)) picker.value=initial;
  picker.addEventListener('change',()=>choose(picker.value));
  toggle.addEventListener('change',update);
  root.addEventListener('click',e=>{
    const marker=(e.target as Element).closest<SVGGElement>('.map-marker');
    if(marker?.dataset.class) choose(marker.dataset.class);
  });
  const aligned=root.querySelector<HTMLElement>('#aligned')!;
  for(const input of aligned.querySelectorAll<HTMLInputElement>('[data-state-toggle]')){
    input.addEventListener('change',()=>{
      for(const layer of aligned.querySelectorAll<SVGElement>('[data-state]')){
        if(layer.dataset.state===input.dataset.stateToggle) layer.classList.toggle('layer-off',!input.checked);
      }
    });
  }
  update();
</script>
<style is:global>
  #shape-view{padding-bottom:54px}
  .map-controls{margin:0 0 16px;align-items:center}
  .center-toggle{display:flex;align-items:center;gap:7px;margin-left:auto;cursor:pointer}
  #shape-view input{accent-color:var(--accent)}
  .state-triptych{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2px;border-radius:12px;overflow:hidden;background:#303036}
  .state-map{margin:0;background:black;color:white;min-width:0}
  #chromophy,#aligned{scroll-margin-top:76px}
  .state-map figcaption{padding:18px 20px 0}
  .state-map h3{font-size:1.18rem;margin:0 0 4px;color:#f4f4f8}
  .state-map figcaption p{margin:0;font-size:.87rem;color:#bfbfc8}
  .state-map > svg{display:block;width:100%}
  .state-cloud{opacity:.6}.cloud-only .state-cloud{opacity:1}
  .center-path{fill:none;stroke:#e3e1ec;stroke-width:1.4;stroke-linejoin:round}
  .map-marker{cursor:pointer}.center-dot{stroke:#f3f2f5;stroke-width:.7}
  .selection-ring{display:none;fill:none;stroke:white;stroke-width:1.7;pointer-events:none}
  .point-label{display:none;fill:white;stroke:#080808;stroke-width:2.4px;paint-order:stroke;font-size:12px;font-weight:650;pointer-events:none}
  .map-marker.selected .point-label,.map-marker.selected .selection-ring,#shape-view:not(.has-selection) .endpoint{display:block}
  .has-selection .map-marker:not(.selected){opacity:.35}.has-selection .center-path{opacity:.55}
  .cloud-only .state-centers,#shape-view .layer-off{display:none}
  .map-readout{font-weight:600}
  .overlay-map{border-radius:12px;overflow:hidden;margin-top:28px;position:relative}
  .overlay-map > svg{width:min(100%,620px);margin:auto}
  .overlay-map .cloud-layer{mix-blend-mode:screen}
  .overlay-map .state-cloud{opacity:.36}.cloud-only .overlay-map .state-cloud{opacity:.6}
  .overlay-map .center-path{stroke-width:.9}
  .overlay-map .fish .center-path,.line-sample.fish{stroke-dasharray:5 3;border-top-style:dashed}
  .overlay-map .live .center-path,.line-sample.live{stroke-dasharray:1 2.5;stroke-linecap:round;border-top-style:dotted}
  .layer-controls{display:flex;gap:8px 18px;flex-wrap:wrap;border:0;margin:12px 20px 0;padding:0}
  .layer-controls label{display:inline-flex;gap:6px;align-items:center;color:white;font-size:.85rem;cursor:pointer}
  .line-sample{width:16px;border-top:2px solid currentColor}
  .visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
  @media(max-width:680px){
    .state-triptych{grid-template-columns:1fr}
    .state-map{width:100%}.state-triptych .state-map > svg{max-height:350px}
    .center-toggle{margin-left:0}
  }
</style>
