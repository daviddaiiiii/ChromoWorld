---
import Base from '../layouts/Base.astro';
import feature from '../data/live-feature.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (name:string) => base + '/assets/' + name;
const explorers = [
  { category:'Fixed 2D', title:'Chromosome atlas', img:'atlas-preview.webp',
    alt:'Annotated chromosome in G-banding and FISH microscopy',
    description:'Choose a chromosome class. Slide between the reference annotation and the ChromoPix prediction.',
    links:[['Open the atlas','/virtual-fish/#class-atlas']] },
  { category:'Live 4D', title:'Mitosis explorer', img:'tracked-preview.webp',
    alt:'A DNA projection next to color-coded tracked chromosomes',
    description:'Follow a division frame by frame, or compare how three models separate the same chromosomes.',
    links:[['Explore tracks',`/live-4d/?sample=${feature.sample}&t=${feature.time}&view=front`],['Compare methods','/live-4d/compare/']] },
  { category:'Morphology', title:'Identity across states', img:'shape-preview.webp?v=2',
    alt:'UMAP clouds and chromosome-class centroids in G-banding, FISH and live cells',
    description:'Locate the same chromosome class in G-banding, FISH and live cells using UMAP and class centroids.',
    links:[['Explore the maps','/identity-flow/']] },
];
const chapters = [[0,'Karyotype'],[22,'Full pipeline'],[43,'Banding to FISH'],[77,'ChromoPix'],[94,'Robustness'],[134,'Morphology & UMAP'],[163,'ChromoPhy'],[173,'ChromoPose'],[211,'ChromoLift'],[233,'ChromoID'],[269,'Patient Chr14'],[302,'Clinical follow-up']];
---
<Base>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span class="spectrum" aria-hidden="true"></span> Live-cell karyotyping</p>
        <h1>Chromosome identity in motion.</h1>
        <p class="lead">A karyotype identifies chromosomes in a single image. Can we follow those same identities as a living cell divides?</p>
        <div class="actions">
          <a class="button primary" href="#explore">Explore the data</a>
          <a class="button secondary" href={base+'/methods/'}>See the pipeline</a>
        </div>
      </div>
      <div class="hero-film">
        <figure class="film">
          <video id="intro" controls playsinline preload="metadata" poster={asset('intro-poster.webp?v=14')} aria-label="A Karyotype in Motion">
            <source src={asset('intro-stream.webm')} type='video/webm; codecs="vp9, opus"' />
            <source src={asset('intro.mp4?v=14')} type="video/mp4" />
            <track kind="captions" srclang="en" label="English" src={asset('intro-en.vtt?v=13')} />
            <track kind="subtitles" srclang="zh-Hans" label="简体中文" src={asset('intro-zh.vtt?v=13')} />
          </video>
          <figcaption><strong>A Karyotype in Motion</strong><span class="film-formats"><a id="intro-hd" href={asset('intro.mp4?v=14')}>Open HD MP4</a><span>5:38</span></span></figcaption>
        </figure>
        <p id="film-error" class="film-credit" role="status" hidden>Video unavailable here. <a href="https://github.com/daviddaiiiii/ChromoWorld/blob/main/site/public/assets/intro.mp4">Get the film on GitHub</a>.</p>
        <details class="film-chapters">
          <summary>Chapters <span id="current-chapter">{chapters[0][1]}</span></summary>
          <div class="chapter-row" aria-label="Jump to a video chapter">
            {chapters.map(([time,label]) => <button data-time={time} type="button"><span aria-hidden="true">{Math.floor(Number(time)/60)}:{String(Number(time)%60).padStart(2,'0')}</span>{label}</button>)}
          </div>
        </details>
        <p class="film-credit">Music · <a href="https://www.scottbuckley.com.au/library/a-kind-of-hope/">“A Kind Of Hope” by Scott Buckley</a> · <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a></p>
      </div>
    </div>
  </section>

  <section class="section shell" id="explore">
    <div class="section-heading"><h2>Explore the data</h2></div>
    <div class="explorer-grid">
      {explorers.map(item => (
        <article class="tile explorer-card">
          <a href={base+item.links[0][1]} class="tile-media" aria-label={item.title}>
            <img src={asset(item.img)} loading="lazy" alt={item.alt} width="960" height="446" />
          </a>
          <div class="copy">
            <p class="eyebrow">{item.category}</p>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <div class="actions">
              {item.links.map(([label,path]) => <a class="text-link" href={base+path}>{label}</a>)}
            </div>
          </div>
        </article>
      ))}
    </div>
    <div class="resource-band">
      <div><h3>Work with the data</h3><p>Download the microscopy, run a model or reproduce a figure.</p></div>
      <div class="actions">
        <a class="button" href={base+'/datasets/'}>Dataset downloads</a>
        <a class="button" href="https://github.com/daviddaiiiii/ChromoWorld">GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</Base>
<script>
  const film = document.querySelector<HTMLVideoElement>('#intro')!;
  const chapters = [...document.querySelectorAll<HTMLButtonElement>('[data-time]')];
  const hd = document.querySelector<HTMLAnchorElement>('#intro-hd')!;
  const filmError = document.querySelector<HTMLElement>('#film-error')!;
  let playing = false;
  film.addEventListener('play', () => { playing = true; });
  film.addEventListener('loadeddata', () => { filmError.hidden = true; });
  film.querySelector('source[type="video/mp4"]')!.addEventListener('error', () => { filmError.hidden = false; });
  film.addEventListener('pause', () => { if (!film.error) playing = false; });
  film.addEventListener('error', () => {
    // The browser handles unsupported sources before playback. Recover if a
    // selected WebM fails later, retaining the chapter and playback intent.
    if (!film.currentSrc.endsWith('.webm') || film.getAttribute('src')) {
      filmError.hidden = false;
      return;
    }
    const time = film.currentTime, resume = playing;
    film.addEventListener('loadedmetadata', () => {
      film.currentTime = Math.min(time, film.duration);
      if (resume) film.play().catch(() => {});
    }, { once:true });
    film.src = hd.href;
    film.load();
  });
  let active: HTMLButtonElement | undefined;
  function updateChapter() {
    const chapter = chapters.findLast(button => Number(button.dataset.time) <= film.currentTime);
    if (chapter === active) return;
    active?.removeAttribute('aria-current');
    chapter?.setAttribute('aria-current', 'true');
    if (chapter) document.getElementById('current-chapter')!.textContent = chapter.lastChild?.textContent ?? '';
    active = chapter;
  }
  film.addEventListener('timeupdate', updateChapter);
  film.addEventListener('seeked', updateChapter);
  const requestedTime = new URL(location.href).searchParams.get('t');
  if (requestedTime && /^\d+(\.\d+)?$/.test(requestedTime)) {
    const seek = () => { film.currentTime = Math.min(Number(requestedTime), film.duration); };
    if (film.readyState >= 1) seek();
    else film.addEventListener('loadedmetadata', seek, { once: true });
  }
  updateChapter();
  for (const button of chapters) {
    button.addEventListener('click', () => {
      film.currentTime = Number(button.dataset.time);
      updateChapter();
      film.play().catch(() => {});
    });
  }
</script>
