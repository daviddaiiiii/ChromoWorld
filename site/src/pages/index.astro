---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (name:string) => base + '/assets/' + name;
const explorers = [
  { category:'Fixed 2D', title:'Chromosome atlas', img:'atlas-preview.webp',
    alt:'Annotated chromosome in G-banding and FISH microscopy',
    description:'Browse all 24 chromosome classes and compare reference annotations with ChromoPix predictions.',
    links:[['Open the atlas','/virtual-fish/#class-atlas']] },
  { category:'Live 4D', title:'Mitosis explorer', img:'pose-preview.webp',
    alt:'A DNA projection next to color-coded tracked chromosomes',
    description:'Follow individual chromosomes through a division and compare three segmentation methods on synchronized frames.',
    links:[['Explore tracks','/live-4d/'],['Compare methods','/live-4d/compare/']] },
  { category:'Morphology', title:'Identity across states', img:'shape-preview.webp',
    alt:'Rainbow-colored morphology maps for G-banding and FISH',
    description:'Compare the arrangement of chromosome classes in the G-banding and FISH morphology maps.',
    links:[['Explore the maps','/identity-flow/']] },
];
const chapters = [[0,'Live imaging'],[11,'G-banding'],[25,'FISH & ChromoPix'],[41,'Morphology & UMAP'],[78,'ChromoPhy'],[109,'Patient Chr14']];
---
<Base>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span class="spectrum" aria-hidden="true"></span> ChromoWorld</p>
        <h1>Chromosome identity in motion.</h1>
        <p class="lead">From fixed-cell morphology to chromosome segregation in living cells.</p>
        <div class="actions">
          <a class="button primary" href="#explore">Explore the data <span aria-hidden="true">↓</span></a>
          <a class="button secondary" href={base+'/methods/'}>See the pipeline</a>
        </div>
      </div>
      <div class="hero-film">
        <figure class="film">
          <figcaption><strong>Project overview</strong><span>2:18</span></figcaption>
          <video id="intro" controls playsinline preload="metadata" poster={asset('intro-poster.webp?v=5')} src={asset('intro.mp4?v=5')} aria-label="ChromoWorld project overview"></video>
        </figure>
        <div class="chapter-row" aria-label="Jump to a video chapter">
          {chapters.map(([time,label]) => <button data-time={time} type="button">{label}</button>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section shell" id="explore">
    <div class="section-heading"><h2>Explore the data</h2></div>
    <div class="explorer-grid">
      {explorers.map(item => (
        <article class="tile explorer-card">
          <a href={base+item.links[0][1]} class="tile-media" aria-label={item.title}>
            <img src={asset(item.img)} loading="lazy" alt={item.alt} width="960" height="446" />
          </a>
          <div class="copy">
            <p class="eyebrow">{item.category}</p>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <div class="actions">
              {item.links.map(([label,path]) => <a class="text-link" href={base+path}>{label} <span aria-hidden="true">→</span></a>)}
            </div>
          </div>
        </article>
      ))}
    </div>
    <div class="resource-band">
      <div><h3>Code, models and datasets</h3><p>Reproduce the figures, run inference or download the data.</p></div>
      <div class="actions">
        <a class="button" href={base+'/datasets/'}>Dataset downloads</a>
        <a class="button" href="https://github.com/daviddaiiiii/ChromoWorld">GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</Base>
<script>
  const film = document.querySelector<HTMLVideoElement>('#intro')!;
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-time]')) {
    button.addEventListener('click', () => {
      film.currentTime = Number(button.dataset.time);
      film.play().catch(() => {});
    });
  }
</script>
